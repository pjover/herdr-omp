#!/bin/sh
# herdr-omp: open a Herdr session for the current directory with omp running in it.
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pere Jover
# https://github.com/pjover/herdr-omp
set -eu

usage() {
  cat <<'EOF'
usage: herdr-omp [SESSION]

Attach to the Herdr session SESSION (default: the current directory's name).

If the session does not exist yet, Herdr creates it with a workspace in the
current directory, and omp is started in that workspace's first pane.
Existing sessions, running or stopped, are attached or restored as they are.
EOF
}

case "${1-}" in
  -h | --help) usage; exit 0 ;;
  -*) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

for bin in herdr omp; do
  command -v "$bin" >/dev/null 2>&1 || {
    echo "herdr-omp: '$bin' not found in PATH; see https://github.com/pjover/herdr-omp#requirements" >&2
    exit 127
  }
done

session=${1:-$(basename "$(pwd -P)" | tr -c 'A-Za-z0-9_.\n-' '-')}
h() { herdr --session "$session" "$@"; }

# Brand-new session: the client below starts a detached server and opens a
# workspace in $PWD. Once its root pane is at a shell prompt, start omp there.
if ! herdr session list | awk -v s="$session" 'NR > 1 && $1 == s { found = 1 } END { exit !found }'; then
  (
    i=0
    until pane=$(h pane list 2>/dev/null | sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p') &&
      [ -n "$pane" ] && h agent start omp --kind omp --pane "$pane"; do
      i=$((i + 1))
      [ "$i" -le 100 ] || exit 1
      sleep 0.2
    done
  ) >/dev/null 2>&1 &
fi

exec herdr --session "$session"
